{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruphysbert:schema:works:v1",
  "title": "Реестр научных работ корпуса ruPhysBERT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "work_id",
    "work_aliases",
    "source_group_id",
    "source_id",
    "platform",
    "journal_id",
    "journal_title",
    "canonical_url",
    "doi",
    "edn",
    "identity_confidence",
    "title",
    "authors",
    "abstract",
    "keywords",
    "published_at",
    "language",
    "genre",
    "pacs_codes_raw",
    "udc_codes_raw",
    "publisher_section",
    "duplicate_of_work_id",
    "eligibility_status",
    "exclusion_reason",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "works-v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "work_id": {"type": "string", "minLength": 1},
    "work_aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source_group_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "platform": {"type": ["string", "null"]},
    "journal_id": {"type": "string", "minLength": 1},
    "journal_title": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri"},
    "doi": {"type": ["string", "null"]},
    "edn": {"type": ["string", "null"]},
    "identity_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"type": "string"}},
    "abstract": {"type": ["string", "null"]},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "published_at": {
      "anyOf": [
        {"type": "string", "format": "date"},
        {"type": "null"}
      ]
    },
    "language": {"type": "string", "minLength": 2},
    "genre": {
      "type": "string",
      "enum": [
        "research_article",
        "review_article",
        "short_communication",
        "other"
      ]
    },
    "pacs_codes_raw": {
      "type": "array",
      "items": {"$ref": "#/$defs/codeSignal"}
    },
    "udc_codes_raw": {
      "type": "array",
      "items": {"$ref": "#/$defs/codeSignal"}
    },
    "publisher_section": {"type": ["string", "null"]},
    "duplicate_of_work_id": {"type": ["string", "null"]},
    "eligibility_status": {
      "type": "string",
      "enum": ["pending", "eligible", "rejected", "quarantined"]
    },
    "exclusion_reason": {"type": ["string", "null"]},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "codeSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "source_url", "retrieved_at", "evidence_sha256"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"eligibility_status": {"const": "eligible"}},
        "required": ["eligibility_status"]
      },
      "then": {
        "properties": {
          "abstract": {"type": "string", "minLength": 1},
          "language": {"const": "ru"},
          "genre": {
            "enum": ["research_article", "review_article", "short_communication"]
          },
          "published_at": {
            "type": "string",
            "pattern": "^(200[0-9]|201[0-9]|202[0-5])-[0-9]{2}-[0-9]{2}$"
          },
          "duplicate_of_work_id": {"type": "null"},
          "exclusion_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "eligibility_status": {"enum": ["rejected", "quarantined"]}
        },
        "required": ["eligibility_status"]
      },
      "then": {
        "properties": {
          "exclusion_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
