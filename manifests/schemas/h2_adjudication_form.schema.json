{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruphysbert:schema:h2-adjudication-form:v1",
  "title": "Бланк арбитража H2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_batch_id",
    "audit_id",
    "audit_frame_version",
    "candidate_frame_id",
    "annotation_item_id",
    "h2_scheme_version",
    "adjudication_kind",
    "blinded_title",
    "blinded_abstract",
    "labeling_guide_version",
    "input_sha256",
    "evidence_bundle_sha256",
    "adjudicator_id",
    "source_decisions",
    "grnti_evidence",
    "adjudicated_decision",
    "grnti_conflict_outcome",
    "adjudication_reason",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "h2-adjudication-form-v1"},
    "task_batch_id": {"type": "string", "minLength": 1},
    "audit_id": {"type": "string", "minLength": 1},
    "audit_frame_version": {"type": "string", "minLength": 1},
    "candidate_frame_id": {"type": "string", "minLength": 1},
    "annotation_item_id": {"type": "string", "minLength": 1},
    "h2_scheme_version": {"type": "string", "minLength": 1},
    "adjudication_kind": {
      "type": "string",
      "enum": ["annotator_disagreement", "grnti_conflict"]
    },
    "blinded_title": {"type": "string", "minLength": 1},
    "blinded_abstract": {"type": ["string", "null"]},
    "labeling_guide_version": {"type": "string", "minLength": 1},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_bundle_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "adjudicator_id": {"type": "string", "minLength": 1},
    "source_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceDecision"},
      "uniqueItems": true
    },
    "grnti_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/grntiEvidence"},
      "uniqueItems": true
    },
    "adjudicated_decision": {
      "anyOf": [{"$ref": "#/$defs/decision"}, {"type": "null"}]
    },
    "grnti_conflict_outcome": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["catalog_confirmed", "catalog_rejected", "unresolved_excluded"]
        },
        {"type": "null"}
      ]
    },
    "adjudication_reason": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {
      "type": "string",
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "OTHER",
        "AMBIGUOUS",
        "INSUFFICIENT"
      ]
    },
    "sourceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label_record_id", "record_type", "decision", "rationale"],
      "properties": {
        "label_record_id": {"type": "string", "minLength": 1},
        "record_type": {
          "type": "string",
          "enum": ["annotation", "annotation_adjudication"]
        },
        "decision": {"$ref": "#/$defs/decision"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "grntiEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_record_id",
        "code",
        "assignment_source_type",
        "assignment_source_id",
        "source_url",
        "evidence_sha256",
        "is_primary_explicit"
      ],
      "properties": {
        "label_record_id": {"type": "string", "minLength": 1},
        "code": {"type": "string", "pattern": "^[0-9]{2}(\\.[0-9]{2}){1,2}$"},
        "assignment_source_type": {
          "type": "string",
          "enum": ["publisher", "bibliographic_catalog"]
        },
        "assignment_source_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "is_primary_explicit": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"adjudication_kind": {"const": "annotator_disagreement"}},
        "required": ["adjudication_kind"]
      },
      "then": {
        "properties": {
          "source_decisions": {
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/sourceDecision"},
                {"properties": {"record_type": {"const": "annotation"}}}
              ]
            }
          },
          "grnti_evidence": {"maxItems": 0},
          "evidence_bundle_sha256": {"type": "null"},
          "adjudicated_decision": {"$ref": "#/$defs/decision"},
          "grnti_conflict_outcome": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "source_decisions": {
            "oneOf": [
              {
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/sourceDecision"},
                    {"properties": {"record_type": {"const": "annotation"}}}
                  ]
                }
              },
              {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/sourceDecision"},
                    {
                      "properties": {
                        "record_type": {"const": "annotation_adjudication"}
                      }
                    }
                  ]
                }
              }
            ]
          },
          "grnti_evidence": {"minItems": 2},
          "evidence_bundle_sha256": {"$ref": "#/$defs/sha256"},
          "adjudicated_decision": {"type": "null"},
          "grnti_conflict_outcome": {
            "type": "string",
            "enum": ["catalog_confirmed", "catalog_rejected", "unresolved_excluded"]
          }
        }
      }
    }
  ]
}
