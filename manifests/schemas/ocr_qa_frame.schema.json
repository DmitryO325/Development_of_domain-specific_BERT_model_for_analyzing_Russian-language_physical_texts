{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruphysbert:schema:ocr-qa-frame:v1",
  "title": "Заранее выбранная страница для проверки OCR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_record_id",
    "qa_run_id",
    "page_sample_id",
    "work_id",
    "source_id",
    "source_group_id",
    "source_pdf_artifact_id",
    "source_pdf_path",
    "publication_year",
    "page_index",
    "page_number",
    "printed_page_label",
    "page_render_path",
    "page_render_sha256",
    "page_render_dpi",
    "stratum_id",
    "layout",
    "scan_quality",
    "selection_tags",
    "selection_reason",
    "selection_role",
    "created_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "ocr-qa-frame-v1"},
    "frame_record_id": {"type": "string", "minLength": 1},
    "qa_run_id": {"type": "string", "minLength": 1},
    "page_sample_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_group_id": {"type": "string", "minLength": 1},
    "source_pdf_artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_pdf_path": {"type": "string", "minLength": 1},
    "publication_year": {"type": "integer", "minimum": 1, "maximum": 9999},
    "page_index": {"type": "integer", "minimum": 0},
    "page_number": {"type": "integer", "minimum": 1},
    "printed_page_label": {"type": ["string", "null"], "minLength": 1},
    "page_render_path": {"type": "string", "minLength": 1},
    "page_render_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "page_render_dpi": {"type": "integer", "minimum": 72},
    "stratum_id": {"type": "string", "minLength": 1},
    "layout": {
      "type": "string",
      "enum": ["one_column", "two_column", "mixed", "other"]
    },
    "scan_quality": {
      "type": "string",
      "enum": ["born_digital", "clean_scan", "noisy_scan"]
    },
    "selection_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "running_text",
          "first_page",
          "two_columns",
          "mixed_layout",
          "formula",
          "non_russian_text",
          "bibliography",
          "table_or_figure",
          "line_break_hyphenation",
          "image_noise",
          "other"
        ]
      }
    },
    "selection_reason": {"type": "string", "minLength": 1},
    "selection_role": {
      "type": "string",
      "enum": ["stratified_random", "manual_challenge"]
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
