{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruphysbert:schema:ocr-qa-run:v1",
  "title": "Неизменяемый паспорт запуска проверки OCR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qa_run_id",
    "run_kind",
    "run_status",
    "protocol_version",
    "source_artifacts_manifest_path",
    "source_artifacts_schema_id",
    "source_artifacts_manifest_sha256",
    "sample_frame_path",
    "sample_frame_sha256",
    "annotation_guide_path",
    "annotation_guide_sha256",
    "code_commit",
    "selection_plan",
    "variants",
    "comparison_plan",
    "confidence_interval_plan",
    "acceptance_thresholds",
    "review_plan",
    "supersedes_run_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "ocr-qa-run-v1"},
    "qa_run_id": {"type": "string", "minLength": 1},
    "run_kind": {
      "type": "string",
      "enum": ["engineering_pilot", "corpus_gate"]
    },
    "run_status": {"type": "string", "const": "prepared"},
    "protocol_version": {"type": "string", "minLength": 1},
    "source_artifacts_manifest_path": {"type": "string", "minLength": 1},
    "source_artifacts_schema_id": {
      "type": "string",
      "const": "urn:ruphysbert:schema:artifacts:v1"
    },
    "source_artifacts_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "sample_frame_path": {"type": "string", "minLength": 1},
    "sample_frame_sha256": {"$ref": "#/$defs/sha256"},
    "annotation_guide_path": {"type": "string", "minLength": 1},
    "annotation_guide_sha256": {"$ref": "#/$defs/sha256"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "selection_plan": {"$ref": "#/$defs/selectionPlan"},
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/variant"}
    },
    "comparison_plan": {"$ref": "#/$defs/comparisonPlan"},
    "confidence_interval_plan": {"$ref": "#/$defs/confidenceIntervalPlan"},
    "acceptance_thresholds": {"$ref": "#/$defs/acceptanceThresholds"},
    "review_plan": {"$ref": "#/$defs/reviewPlan"},
    "supersedes_run_id": {"type": ["string", "null"], "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selectionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "selection_seed",
        "target_pdf_count",
        "target_page_count",
        "target_manual_challenge_page_count",
        "minimum_prose_characters",
        "stratification_dimensions",
        "strata"
      ],
      "properties": {
        "method": {
          "type": "string",
          "const": "stratified_random_with_manual_challenge_pages"
        },
        "selection_seed": {"type": "integer", "minimum": 0},
        "target_pdf_count": {"type": "integer", "minimum": 1},
        "target_page_count": {"type": "integer", "minimum": 1},
        "target_manual_challenge_page_count": {"type": "integer", "minimum": 0},
        "minimum_prose_characters": {"type": "integer", "minimum": 1},
        "stratification_dimensions": {
          "type": "array",
          "prefixItems": [
            {"const": "source_id"},
            {"const": "publication_year"},
            {"const": "scan_quality"},
            {"const": "layout"}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "strata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/selectionStratum"}
        }
      }
    },
    "selectionStratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum_id",
        "source_id",
        "source_group_id",
        "year_from",
        "year_to",
        "scan_quality",
        "layout",
        "target_pages",
        "minimum_prose_characters"
      ],
      "properties": {
        "stratum_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_group_id": {"type": "string", "minLength": 1},
        "year_from": {"type": "integer", "minimum": 1, "maximum": 9999},
        "year_to": {"type": "integer", "minimum": 1, "maximum": 9999},
        "scan_quality": {"$ref": "#/$defs/scanQuality"},
        "layout": {"$ref": "#/$defs/layout"},
        "target_pages": {"type": "integer", "minimum": 1},
        "minimum_prose_characters": {"type": "integer", "minimum": 1}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "extraction_method",
        "extraction_version",
        "ocr_method",
        "ocr_version",
        "tessdata_version",
        "language_data_versions",
        "configuration_path",
        "configuration_sha256",
        "parameters"
      ],
      "properties": {
        "variant_id": {"type": "string", "minLength": 1},
        "extraction_method": {
          "type": "string",
          "enum": ["pdf", "pdf_ocr_layout"]
        },
        "extraction_version": {"type": "string", "minLength": 1},
        "ocr_method": {"type": ["string", "null"], "minLength": 1},
        "ocr_version": {"type": ["string", "null"], "minLength": 1},
        "tessdata_version": {"type": ["string", "null"], "minLength": 1},
        "language_data_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/languageDataVersion"}
        },
        "configuration_path": {"type": ["string", "null"], "minLength": 1},
        "configuration_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "parameters": {"$ref": "#/$defs/variantParameters"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"extraction_method": {"const": "pdf_ocr_layout"}},
            "required": ["extraction_method"]
          },
          "then": {
            "properties": {
              "ocr_method": {"type": "string", "minLength": 1},
              "ocr_version": {"type": "string", "minLength": 1},
              "tessdata_version": {"type": "string", "minLength": 1},
              "language_data_versions": {"minItems": 1},
              "configuration_path": {"type": "string", "minLength": 1},
              "configuration_sha256": {"$ref": "#/$defs/sha256"},
              "parameters": {
                "properties": {
                  "ocr_dpi": {"type": "integer", "minimum": 72},
                  "page_segmentation_mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 13
                  },
                  "layout_scan_dpi": {"type": "integer", "minimum": 72},
                  "column_gutter_pt": {"type": "number", "exclusiveMinimum": 0},
                  "column_split_ratio": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1
                  },
                  "split_margin_pt": {"type": "number", "minimum": 0},
                  "minimum_header_pt": {"type": "number", "minimum": 0}
                }
              }
            }
          },
          "else": {
            "properties": {
              "ocr_method": {"type": "null"},
              "ocr_version": {"type": "null"},
              "tessdata_version": {"type": "null"},
              "language_data_versions": {"maxItems": 0},
              "configuration_path": {"type": "null"},
              "configuration_sha256": {"type": "null"},
              "parameters": {
                "properties": {
                  "ocr_dpi": {"type": "null"},
                  "page_segmentation_mode": {"type": "null"},
                  "layout_scan_dpi": {"type": "null"},
                  "column_gutter_pt": {"type": "null"},
                  "column_split_ratio": {"type": "null"},
                  "split_margin_pt": {"type": "null"},
                  "minimum_header_pt": {"type": "null"}
                }
              }
            }
          }
        }
      ]
    },
    "languageDataVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "version"],
      "properties": {
        "language": {"type": "string", "minLength": 2},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "variantParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ocr_dpi",
        "page_segmentation_mode",
        "layout_scan_dpi",
        "column_gutter_pt",
        "column_split_ratio",
        "split_margin_pt",
        "minimum_header_pt"
      ],
      "properties": {
        "ocr_dpi": {"type": ["integer", "null"], "minimum": 72},
        "page_segmentation_mode": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 13
        },
        "layout_scan_dpi": {"type": ["integer", "null"], "minimum": 72},
        "column_gutter_pt": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "column_split_ratio": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "split_margin_pt": {"type": ["number", "null"], "minimum": 0},
        "minimum_header_pt": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "comparisonPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_serialization",
        "prose_normalization_version",
        "metric_version",
        "cer_unit",
        "wer_tokenization",
        "excluded_from_prose_metrics"
      ],
      "properties": {
        "text_serialization": {
          "type": "string",
          "const": "utf8-nfc-lf-v1"
        },
        "prose_normalization_version": {"type": "string", "minLength": 1},
        "metric_version": {"type": "string", "minLength": 1},
        "cer_unit": {"type": "string", "const": "unicode_code_point"},
        "wer_tokenization": {
          "type": "string",
          "const": "whitespace_after_normalization"
        },
        "excluded_from_prose_metrics": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "bibliography",
              "formula",
              "non_russian_text",
              "table",
              "figure_caption"
            ]
          },
          "allOf": [
            {"contains": {"const": "bibliography"}, "minContains": 1},
            {"contains": {"const": "formula"}, "minContains": 1},
            {"contains": {"const": "non_russian_text"}, "minContains": 1},
            {"contains": {"const": "table"}, "minContains": 1},
            {"contains": {"const": "figure_caption"}, "minContains": 1}
          ]
        }
      }
    },
    "confidenceIntervalPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "confidence_level",
        "side",
        "cluster_units",
        "replicates",
        "bootstrap_seed",
        "quantile_method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "const": "hierarchical_cluster_bootstrap"
        },
        "confidence_level": {"type": "number", "const": 0.95},
        "side": {"type": "string", "const": "one_sided"},
        "cluster_units": {
          "type": "array",
          "prefixItems": [
            {"const": "work_id"},
            {"const": "page_sample_id"}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "replicates": {"type": "integer", "minimum": 2000},
        "bootstrap_seed": {"type": "integer", "minimum": 0},
        "quantile_method": {"type": "string", "const": "percentile"}
      }
    },
    "acceptanceThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_cer_upper_bound",
        "maximum_wer_upper_bound",
        "maximum_critical_reading_order_rate_upper_bound",
        "minimum_formula_detection_f1_lower_bound",
        "maximum_critical_formula_damage_rate_upper_bound",
        "minimum_group_pages",
        "minimum_group_prose_characters",
        "minimum_formula_occurrences",
        "minimum_formula_work_ids"
      ],
      "properties": {
        "maximum_cer_upper_bound": {"type": "number", "const": 0.03},
        "maximum_wer_upper_bound": {"type": "number", "const": 0.1},
        "maximum_critical_reading_order_rate_upper_bound": {
          "type": "number",
          "const": 0.05
        },
        "minimum_formula_detection_f1_lower_bound": {
          "type": "number",
          "const": 0.9
        },
        "maximum_critical_formula_damage_rate_upper_bound": {
          "type": "number",
          "const": 0.05
        },
        "minimum_group_pages": {"type": "integer", "const": 10},
        "minimum_group_prose_characters": {"type": "integer", "const": 2000},
        "minimum_formula_occurrences": {"type": "integer", "const": 200},
        "minimum_formula_work_ids": {"type": "integer", "const": 30}
      }
    },
    "reviewPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_ids",
        "gold_verification_required",
        "variant_labels_blinded",
        "reviewer_materials_exclude_variant_configuration"
      ],
      "properties": {
        "reviewer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "gold_verification_required": {"type": "boolean", "const": true},
        "variant_labels_blinded": {"type": "boolean", "const": true},
        "reviewer_materials_exclude_variant_configuration": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "scanQuality": {
      "type": "string",
      "enum": ["born_digital", "clean_scan", "noisy_scan"]
    },
    "layout": {
      "type": "string",
      "enum": ["one_column", "two_column", "mixed", "other"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"run_kind": {"const": "corpus_gate"}},
        "required": ["run_kind"]
      },
      "then": {
        "properties": {
          "selection_plan": {
            "allOf": [
              {"$ref": "#/$defs/selectionPlan"},
              {
                "properties": {
                  "target_pdf_count": {"minimum": 30, "maximum": 50},
                  "target_page_count": {"minimum": 100},
                  "minimum_prose_characters": {"minimum": 20000}
                }
              }
            ]
          }
        }
      }
    }
  ]
}
