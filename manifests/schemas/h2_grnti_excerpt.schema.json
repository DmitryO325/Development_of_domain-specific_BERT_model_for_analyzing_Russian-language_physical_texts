{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruphysbert:schema:h2-grnti-excerpt:v1",
  "title": "Выписка ГРНТИ для разметки H2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "excerpt_version",
    "status",
    "grnti_scheme_version",
    "created_at",
    "source",
    "selected_branches",
    "boundary_branches",
    "completeness_check"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "h2-grnti-excerpt-v1"},
    "excerpt_version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["draft", "verified"]},
    "grnti_scheme_version": {"type": "string", "const": "GRNTI-2025"},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/source"},
    "selected_branches": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/selectedBranch"},
      "allOf": [
        {"contains": {"properties": {"class_id": {"const": "C1"}, "level2_code": {"const": "29.05"}}, "required": ["class_id", "level2_code"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"class_id": {"const": "C2"}, "level2_code": {"const": "29.15"}}, "required": ["class_id", "level2_code"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"class_id": {"const": "C3"}, "level2_code": {"const": "29.19"}}, "required": ["class_id", "level2_code"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"class_id": {"const": "C4"}, "level2_code": {"const": "29.27"}}, "required": ["class_id", "level2_code"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"class_id": {"const": "C5"}, "level2_code": {"const": "29.33"}}, "required": ["class_id", "level2_code"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "boundary_branches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/boundaryBranch"},
      "contains": {
        "properties": {"code": {"const": "29.32"}},
        "required": ["code"]
      },
      "minContains": 1
    },
    "completeness_check": {"$ref": "#/$defs/completenessCheck"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classId": {"type": "string", "enum": ["C1", "C2", "C3", "C4", "C5"]},
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf_page_number", "printed_page_label"],
      "properties": {
        "pdf_page_number": {"type": "integer", "minimum": 1},
        "printed_page_label": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "title",
        "source_url",
        "retrieved_at",
        "local_path",
        "sha256",
        "bytes",
        "page_count"
      ],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "local_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "crossReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "target_code", "target_text", "source_locator"],
      "properties": {
        "relation": {
          "type": "string",
          "enum": ["see", "see_also", "reference_from", "equivalent"]
        },
        "target_code": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9]{2}(\\.[0-9]{2}){0,2}$"},
            {"type": "null"}
          ]
        },
        "target_text": {"type": "string", "minLength": 1},
        "source_locator": {"$ref": "#/$defs/sourceLocator"}
      }
    },
    "subrubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "source_locators", "cross_references"],
      "properties": {
        "code": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "source_locators": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceLocator"}
        },
        "cross_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/crossReference"}
        }
      }
    },
    "selectedBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "level2_code", "level2_title", "source_locators", "cross_references", "subrubrics"],
      "properties": {
        "class_id": {"$ref": "#/$defs/classId"},
        "level2_code": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}$"},
        "level2_title": {"type": "string", "minLength": 1},
        "source_locators": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceLocator"}
        },
        "cross_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/crossReference"}
        },
        "subrubrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/subrubric"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"class_id": {"const": "C1"}}, "required": ["class_id"]},
          "then": {
            "properties": {
              "level2_code": {"const": "29.05"},
              "level2_title": {"const": "Физика элементарных частиц. Теория полей. Физика высоких энергий"},
              "subrubrics": {"items": {"properties": {"code": {"pattern": "^29\\.05\\.[0-9]{2}$"}}, "required": ["code"]}}
            }
          }
        },
        {
          "if": {"properties": {"class_id": {"const": "C2"}}, "required": ["class_id"]},
          "then": {
            "properties": {
              "level2_code": {"const": "29.15"},
              "level2_title": {"const": "Ядерная физика"},
              "subrubrics": {"items": {"properties": {"code": {"pattern": "^29\\.15\\.[0-9]{2}$"}}, "required": ["code"]}}
            }
          }
        },
        {
          "if": {"properties": {"class_id": {"const": "C3"}}, "required": ["class_id"]},
          "then": {
            "properties": {
              "level2_code": {"const": "29.19"},
              "level2_title": {"const": "Физика твердых тел"},
              "subrubrics": {"items": {"properties": {"code": {"pattern": "^29\\.19\\.[0-9]{2}$"}}, "required": ["code"]}}
            }
          }
        },
        {
          "if": {"properties": {"class_id": {"const": "C4"}}, "required": ["class_id"]},
          "then": {
            "properties": {
              "level2_code": {"const": "29.27"},
              "level2_title": {"const": "Физика плазмы"},
              "subrubrics": {"items": {"properties": {"code": {"pattern": "^29\\.27\\.[0-9]{2}$"}}, "required": ["code"]}}
            }
          }
        },
        {
          "if": {"properties": {"class_id": {"const": "C5"}}, "required": ["class_id"]},
          "then": {
            "properties": {
              "level2_code": {"const": "29.33"},
              "level2_title": {"const": "Лазерная физика"},
              "subrubrics": {"items": {"properties": {"code": {"pattern": "^29\\.33\\.[0-9]{2}$"}}, "required": ["code"]}}
            }
          }
        }
      ]
    },
    "boundaryBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "reason", "source_locators", "cross_references"],
      "properties": {
        "code": {"type": "string", "pattern": "^[0-9]{2}(\\.[0-9]{2})?$"},
        "title": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "source_locators": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceLocator"}
        },
        "cross_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/crossReference"}
        }
      }
    },
    "completenessCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_class_ids",
        "expected_level2_codes",
        "all_level3_copied",
        "all_cross_references_copied",
        "verified_by",
        "verified_at",
        "freeze_ready"
      ],
      "properties": {
        "expected_class_ids": {
          "type": "array",
          "prefixItems": [
            {"const": "C1"}, {"const": "C2"}, {"const": "C3"},
            {"const": "C4"}, {"const": "C5"}
          ],
          "minItems": 5,
          "maxItems": 5
        },
        "expected_level2_codes": {
          "type": "array",
          "prefixItems": [
            {"const": "29.05"}, {"const": "29.15"}, {"const": "29.19"},
            {"const": "29.27"}, {"const": "29.33"}
          ],
          "minItems": 5,
          "maxItems": 5
        },
        "all_level3_copied": {"type": "boolean"},
        "all_cross_references_copied": {"type": "boolean"},
        "verified_by": {"type": ["string", "null"], "minLength": 1},
        "verified_at": {
          "anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
        },
        "freeze_ready": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "verified"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "completeness_check": {
            "properties": {
              "all_level3_copied": {"const": true},
              "all_cross_references_copied": {"const": true},
              "verified_by": {"type": "string", "minLength": 1},
              "verified_at": {"type": "string", "format": "date-time"},
              "freeze_ready": {"const": true}
            }
          }
        }
      }
    }
  ]
}
